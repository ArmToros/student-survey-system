# Copy this file to .env and fill in the values. .env is git-ignored.

# --- Database -------------------------------------------------------------
# Only needed for the Docker path. The LocalDB path uses Windows authentication.
MSSQL_SA_PASSWORD=replace-with-a-strong-local-sql-password

# How "docker compose up" prepares the SSS database:
#   auto    - restore "new database/SSS.bak" if it is there, otherwise seed
#             scripts/seed-dev-data.sql with synthetic sample data
#   restore - always restore, and fail if the backup is missing
#   seed    - always seed, even if the backup is there
SSS_DB_INIT=auto

# --- Frontend -------------------------------------------------------------
# Where the React app sends its API calls.
REACT_APP_API_BASE_URL=http://localhost:5001

# --- Authentication -------------------------------------------------------
# Signing key for the JWT access tokens. At least 32 characters; generate one with:
#   powershell -c "[Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))"
# Outside Development the backend refuses to start without it.
JWT_SIGNING_KEY=replace-with-a-long-random-string-of-at-least-32-characters

# Comma separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Password reset mail --------------------------------------------------
# Where the React app lives; used to build the password reset link.
# Defaults to the first entry in CORS_ALLOWED_ORIGINS.
APP_BASE_URL=http://localhost:3000

# With SMTP_HOST unset the backend writes the reset link to its console instead
# of sending mail, so the flow works locally without a mail server.
#
# For Gmail: SMTP_HOST=smtp.gmail.com, port 587, SSL on, and the address as the
# username. SMTP_PASSWORD must be a 16-character App Password, not the account
# password - Gmail refuses the account password with "535-5.7.8 Username and
# Password not accepted", which looks like a typo but never is. App Passwords
# are at myaccount.google.com/apppasswords, and that page only appears once
# 2-Step Verification is on; without it, it says the setting is unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
SMTP_USE_SSL=true

# The reverse proxy in front of the app, if there is one, as the backend sees
# it connecting - for the Hetzner VPS that is its Tailscale address. Only this
# one address is believed when it reports the real client, and the forwarded
# list is cleared first, so a header invented by a caller is ignored.
#
# Without it the login rate limiter keys on the proxy instead, and its ten
# attempts a minute are shared by everybody: one person signing in locks the
# rest out with a 429. Leave it unset when nothing proxies the app.
TRUSTED_PROXY=

# --- AI assistant (optional) ----------------------------------------------
# Without a key the Chat page shows a clear notice and the rest of the app works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
